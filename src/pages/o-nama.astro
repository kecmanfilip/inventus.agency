---
import Layout from '../layouts/Layout.astro';

const title = 'O nama — Inventus Digital Intelligence';
const description = 'Ko stoji iza Inventus agencije, naša metodologija i pristup digitalnoj obaveštajnoj analizi. Specijalizovani za ofanzivnu bezbednost i OSINT.';

const values = [
  {
    title: 'Ofanzivni mindset',
    desc: 'Ne čekamo da se napad desi. Mi mislimo kao napadači kako bismo otkrili ranjivosti pre njih.'
  },
  {
    title: 'Ručna verifikacija',
    desc: 'Svaki nalaz proverava čovek, ne samo alat. Automatizacija daje lažnu sigurnost — mi dajemo kontekst.'
  },
  {
    title: 'Puna transparentnost',
    desc: 'Svi izvori su javni i proverivi. Ne koristimo metode koje ne možemo da objasnimo pred pravnim timom.'
  },
  {
    title: 'Poverljivost pre svega',
    desc: 'Klijent kontroliše informacije. Bez iznošenja detalja trećim stranama. Bez medijskih objava bez saglasnosti.'
  }
];

const methodology = [
  {
    step: '01',
    title: 'Pasive reconnaissance',
    desc: 'Prikupljamo informacije bez direktne interakcije sa ciljnim sistemima. DNS zapisi, javni registri, arhive, društvene mreže.'
  },
  {
    step: '02',
    title: 'Semi-pasive analysis',
    desc: 'Analiziramo javno dostupne servise, API-je, certifikate, tehnološki stek — sve što ne zahteva autentikaciju.'
  },
  {
    step: '03',
    title: 'Korelacija i kontekst',
    desc: 'Povezujemo različite izvore informacija, otkrivamo skrivene veze i dajemo kontekst svakom nalazu.'
  },
  {
    step: '04',
    title: 'Verifikacija i rangiranje',
    desc: 'Svaki nalaz ručno proveravamo, rangiramo po ozbiljnosti i dajemo konkretne, izvodive preporuke.'
  }
];
---

<Layout title={title} description={description}>
  <div class="section-padding pt-24">
    <div class="container-wide mx-auto">
      <!-- Hero -->
      <div class="max-w-3xl mb-20 reveal">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent/30 bg-accent/5 mb-8">
          <span class="font-display text-xs tracking-wider text-accent uppercase">O nama</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-medium leading-tight mb-8">
          Digitalna obaveštajna <br/>
          <span class="text-gradient">agencija sa ofanzivnim pristupom.</span>
        </h1>
        <p class="text-lg md:text-xl text-text-secondary leading-relaxed mb-6">
          Inventus je specijalizovana agencija za digitalnu obaveštajnu analizu korporacija. 
          Naš rad se zasniva na principima ofanzivne bezbednosti — mi mislimo kao napadači 
          kako bismo kompanijama pokazali šta internet zna o njima.
        </p>
        <p class="text-text-secondary leading-relaxed">
          Ne nudimo automatizovane skenere koji daju 200-stranični izveštaj pun lažnih pozitiva. 
          Svaku analizu sprovodi stručnjak sa iskustvom u aplikativnoj i mrežnoj bezbednosti, 
          koji ručno verifikuje, kontekstualizuje i rangira svaki nalaz.
        </p>
      </div>

      <!-- Values -->
      <div class="grid md:grid-cols-2 gap-8 mb-20">
        {values.map((v, i) => (
          <div class="p-8 rounded-xl bg-bg-elevated accent-border reveal" class:list={[`reveal-delay-${(i % 2) + 1}`]}>
            <div class="flex items-center gap-3 mb-4">
              <span class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center font-display text-accent text-sm">0{i + 1}</span>
              <h3 class="font-display text-lg">{v.title}</h3>
            </div>
            <p class="text-text-secondary text-sm leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>

      <!-- Methodology -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-16 reveal">
          <h2 class="text-3xl md:text-4xl font-display mb-4">Naša metodologija</h2>
          <p class="text-text-secondary">
            Sistematski pristup koji kombinuje tehničku ekspertizu, OSINT tehnike 
            i analitičko razmišljanje.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {methodology.map((m, i) => (
            <div class="relative reveal" class:list={[`reveal-delay-${i + 1}`]}>
              <div class="p-6 rounded-xl bg-bg-elevated accent-border h-full">
                <span class="font-display text-2xl text-accent/30 mb-4 block">{m.step}</span>
                <h3 class="font-display text-lg mb-3">{m.title}</h3>
                <p class="text-text-secondary text-sm leading-relaxed">{m.desc}</p>
              </div>
              {i < methodology.length - 1 && (
                <div class="hidden lg:block absolute top-1/2 -right-3 w-6 h-px bg-accent/30"></div>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- What makes us different -->
      <div class="grid lg:grid-cols-2 gap-16 items-center mb-20">
        <div class="reveal">
          <h2 class="text-3xl md:text-4xl font-display mb-6">
            Razlika između <span class="text-gradient">Inventusa</span> <br/>i automatizovanih alata
          </h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="w-10 h-10 rounded-lg bg-red-500/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </div>
              <div>
                <h4 class="font-display mb-1 text-red-400">Automatizovani alati</h4>
                <p class="text-text-secondary text-sm">Skeniraju hiljade domena i vrate 200-stranični PDF pun lažnih pozitiva. Klijent ne zna šta je stvaran rizik, a šta buka.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </div>
              <div>
                <h4 class="font-display mb-1 text-accent">Inventus pristup</h4>
                <p class="text-text-secondary text-sm">Ručna analiza sa kontekstom. Svaki nalaz proveravamo, rangiramo po ozbiljnosti i objašnjavamo kako ga iskoristiti. Bez lažne sigurnosti.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="relative reveal reveal-delay-2">
          <div class="absolute inset-0 bg-accent/5 rounded-2xl blur-3xl"></div>
          <div class="relative p-8 rounded-2xl bg-bg-elevated accent-border">
            <div class="font-display text-sm text-text-muted mb-6 tracking-wider uppercase">Princip rada</div>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <span class="text-accent font-display text-sm mt-0.5">→</span>
                <p class="text-text-secondary text-sm">Ne prikupljamo podatke koje klijent već ima — nalazimo ono što je propustio.</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent font-display text-sm mt-0.5">→</span>
                <p class="text-text-secondary text-sm">Ne prodajemo strah — prodajemo informaciju. Svaki izveštaj je objektivan i proveriv.</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent font-display text-sm mt-0.5">→</span>
                <p class="text-text-secondary text-sm">Ne nudimo "beskonačan monitoring" — nudimo konkretan, izvodiv plan delovanja.</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent font-display text-sm mt-0.5">→</span>
                <p class="text-text-secondary text-sm">Ne iznosimo nalaze bez konteksta — svaki rizik objašnjavamo kroz poslovnu perspektivu.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="relative rounded-2xl bg-bg-elevated accent-border p-12 md:p-16 text-center overflow-hidden reveal">
        <div class="absolute inset-0 bg-gradient-to-r from-accent/5 to-transparent pointer-events-none"></div>
        <div class="relative z-10 max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-display mb-6">
            Hvatamo stvari koje alati <span class="text-gradient">ne vide</span>
          </h2>
          <p class="text-text-secondary mb-10 leading-relaxed">
            Ako želite da saznate šta internet zna o vašoj kompaniji — bez automatizovanih izveštaja 
            punih lažnih pozitiva — kontaktirajte nas za besplatnu početnu procenu.
          </p>
          <a href="/kontakt/" class="inline-flex items-center px-8 py-4 bg-accent text-bg-primary font-display font-medium text-sm tracking-wide rounded hover:bg-accent-glow transition-colors">
            Započnite besplatnu procenu
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
