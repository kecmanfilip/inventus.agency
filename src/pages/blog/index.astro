---
import Layout from '../../layouts/Layout.astro';
import Newsletter from '../../components/Newsletter.astro';

const title = 'Blog — Digitalna obaveštajna analiza i online bezbednost';
const description = 'Stručni članci o digitalnoj obaveštajnoj analizi, zaštiti brenda, curenju podataka i online bezbednosti kompanija. Praktični saveti i uputstva.';

const posts = [
  {
    title: 'Kako napadači prikupljaju informacije o vašoj kompaniji pre napada',
    excerpt: 'OSINT reconnaissance: tehnike koje napadači koriste da prikupe informacije o kompanijama pre ciljanog napada. Šta se o vama može pronaći online i kako se zaštititi.',
    slug: 'osint-recon-kompanija',
    date: '2025-05-12',
    readTime: '9 min',
    category: 'OSINT'
  },
  {
    title: '5 stvari koje vaš javni sajt otkriva napadačima — a vi to ne znate',
    excerpt: 'Vaš javni veb sajt je zlatna kopa informacija za napadače. Tehnološki stek, metapodaci, skrivene direktorijume — sve je dostupno svakome ko zna gde da gleda.',
    slug: 'sajt-otkriva-napadacima',
    date: '2025-05-05',
    readTime: '7 min',
    category: 'Website Intelligence'
  },
  {
    title: 'DMARC, SPF, DKIM: Zašto email lažno predstavljanje i dalje funkcioniše u 2025.',
    excerpt: 'Tehničko objašnjenje zašto email autentikacija često ne radi i kako napadači lažno predstavljaju kompanije. Praktični saveti za zaštitu.',
    slug: 'email-lazno-predstavljanje',
    date: '2025-04-28',
    readTime: '8 min',
    category: 'Email sigurnost'
  },
  {
    title: 'Due diligence u digitalnom dobu: Šta M&A timovi propuste pre akvizicije',
    excerpt: 'Digitalna due diligence za M&A transakcije: koje informacije o ciljnoj kompaniji su dostupne online i kako ih legalno prikupiti pre potpisivanja ugovora.',
    slug: 'due-diligence-digitalno-doba',
    date: '2025-04-20',
    readTime: '11 min',
    category: 'M&A'
  },
  {
    title: 'Šta je digitalni otisak kompanije i zašto je važan u 2025?',
    excerpt: 'Digitalni otisak je sve što se o vašoj kompaniji može pronaći na internetu. U ovom članku objašnjavamo šta obuhvata, kako napadači koriste ove informacije i kako da zaštitite svoju kompaniju.',
    slug: 'digitalni-otisak-znacaj',
    date: '2025-04-15',
    readTime: '6 min',
    category: 'Digitalni otisak'
  },
  {
    title: 'Dark web monitoring za firme — šta treba da znate',
    excerpt: 'Dark web nije samo mesto ilegalnih aktivnosti — to je i tržište ukradenih podataka. Saznajte kako funkcioniše monitoring, šta možete da otkrijete i kako da reagujete ako vaši podaci procure.',
    slug: 'dark-web-monitoring',
    date: '2025-03-28',
    readTime: '8 min',
    category: 'Dark web'
  },
  {
    title: 'Kako istražiti kompaniju online — vodič za M&A timove',
    excerpt: 'Pre akvizicije ili ulaganja, ključno je znati šta se o ciljnoj kompaniji može pronaći online. Ovaj vodič pokazuje kako legalno i etički prikupiti javno dostupne informacije o poslovnom partneru.',
    slug: 'istraziti-kompaniju-online',
    date: '2025-03-10',
    readTime: '10 min',
    category: 'M&A'
  }
];
---

<Layout title={title} description={description}>
  <div class="section-padding pt-24">
    <div class="container-wide mx-auto">
      <div class="max-w-3xl mb-16">
        <h1 class="text-4xl md:text-5xl font-display mb-6">Blog</h1>
        <p class="text-text-secondary text-lg leading-relaxed">
          Stručni članci, uputstva i analize iz oblasti digitalne obaveštajne analize, 
          online bezbednosti i zaštite kompanija na internetu.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map(post => (
          <article class="group flex flex-col rounded-xl bg-bg-elevated accent-border overflow-hidden card-hover">
            <div class="p-8 flex-1 flex flex-col">
              <div class="flex items-center gap-3 text-xs text-text-muted font-display mb-4">
                <span class="px-2 py-0.5 rounded bg-accent/10 text-accent">{post.category}</span>
                <span>{post.date}</span>
                <span>·</span>
                <span>{post.readTime}</span>
              </div>
              <h2 class="text-xl font-display mb-3 group-hover:text-accent transition-colors">
                <a href={`/blog/${post.slug}/`}>{post.title}</a>
              </h2>
              <p class="text-text-secondary text-sm leading-relaxed flex-1">{post.excerpt}</p>
              <a href={`/blog/${post.slug}/`} class="mt-6 inline-flex items-center text-accent font-display text-sm tracking-wide hover:text-accent-glow transition-colors">
                Pročitajte više
                <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-20">
        <Newsletter />
      </div>
    </div>
  </div>
</Layout>
