---
import Layout from '../layouts/Layout.astro';

const title = 'Cenovnik — Digitalna obaveštajna analiza | Inventus';
const description = 'Transparentna struktura cena za digitalnu obaveštajnu analizu, monitoring curenja podataka i bezbednosnu procenu kompanija. Počnite sa besplatnim OSINT skenom.';

const packages = [
  {
    name: 'Osnovni sken',
    tag: 'Za prvi uvid',
    desc: 'Brza procena digitalnog otiska i najkritičnijih ranjivosti. Idealno za kompanije koje prvi put rade bezbednosnu analizu.',
    includes: [
      'Analiza DNS infrastrukture i subdomena',
      'Provera SPF / DMARC / DKIM konfiguracije',
      'Pretraga baza curenja podataka',
      'Otkrivanje javno dostupnih dokumenata',
      'Mini-izveštaj sa prioritetnim preporukama'
    ],
    timeframe: '24–48 sati',
    cta: 'Zatražite osnovni sken',
    featured: false
  },
  {
    name: 'Kompletna analiza',
    tag: 'Najtraženije',
    desc: 'Sveobuhvatan pregled digitalnog otiska, curenja podataka, reputacionih rizika i tehničkih ranjivosti sa detaljnim izveštajem.',
    includes: [
      'Sve iz Osnovnog skena',
      'Dubinska analiza digitalnog otiska',
      'Dark web monitoring za kompanijske podatke',
      'Praćenje typosquat i lookalike domena',
      'Analiza tehnološkog steka i ranjivosti',
      'Detaljan izveštaj sa rangiranim rizicima',
      'Preporuke za smanjenje napadačke površine'
    ],
    timeframe: '5–7 radnih dana',
    cta: 'Zatražite kompletnu analizu',
    featured: true
  },
  {
    name: 'Enterprise / Redovan monitoring',
    tag: 'Za ozbiljne organizacije',
    desc: 'Kontinuirani monitoring digitalnog otiska, redovni izveštaji i prioritetna podrška. Za kompanije koje shvataju bezbednost kao proces.',
    includes: [
      'Sve iz Kompletne analize',
      'Mesečni monitoring curenja podataka',
      'Praćenje novih domena i subdomena',
      'Monitoring lažnih sajtova i phishinga',
      'Kvartalni izveštaj o promenama',
      'Hitna reakcija na kritične nalaze',
      'Direktna komunikacija sa analitičarom'
    ],
    timeframe: 'Ugovor na duži period',
    cta: 'Dogovorite sastanak',
    featured: false
  }
];

const addons = [
  {
    title: 'Obaveštajna analiza konkurencije',
    desc: 'Dubinska analiza digitalnog prisustva konkurenata — tehnologije, izvori saobraćaja, online strategije.'
  },
  {
    title: 'M&A due diligence',
    desc: 'Digitalni rizik profil ciljane kompanije pre akvizicije. Curenje podataka, reputacioni rizici, tehnički dug.'
  },
  {
    title: 'Workshop za IT timove',
    desc: 'Edukativna radionica o digitalnom otisku i OSINT tehnikama za interne bezbednosne timove.'
  }
];
---

<Layout title={title} description={description}>
  <div class="section-padding pt-24">
    <div class="container-wide mx-auto">
      <!-- Hero -->
      <div class="max-w-3xl mx-auto text-center mb-16 reveal">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent/30 bg-accent/5 mb-8">
          <span class="font-display text-xs tracking-wider text-accent uppercase">Cenovnik</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-display mb-6">
          Transparentna struktura <span class="text-gradient">cena</span>
        </h1>
        <p class="text-text-secondary text-lg leading-relaxed mb-4">
          Bez skrivenih troškova. Bez obaveznih ugovora. Bez automatizovanih izveštaja 
          koje niko ne čita. Platite samo za analizu koju stručnjak ručno sprovede 
          i verifikuje.
        </p>
        <p class="text-text-muted text-sm">
          Konkretne cene zavise od obima, složenosti i broja domena. 
          Kontaktirajte nas za personalizovanu ponudu.
        </p>
      </div>

      <!-- Packages -->
      <div class="grid lg:grid-cols-3 gap-8 mb-20">
        {packages.map((pkg, i) => (
          <div 
            class={`relative rounded-xl overflow-hidden reveal ${pkg.featured ? 'lg:-mt-4 lg:mb-4' : ''}`} 
            class:list={[`reveal-delay-${i + 1}`]}
          >
            {pkg.featured && (
              <div class="absolute top-0 left-0 right-0 bg-accent text-bg-primary text-center py-2 font-display text-xs tracking-wider uppercase">
                Najtraženije
              </div>
            )}
            <div class={`p-8 h-full flex flex-col ${pkg.featured ? 'pt-14 bg-bg-elevated accent-border border-accent/40' : 'bg-bg-elevated accent-border'}`}>
              <div class="mb-6">
                <span class="text-text-muted text-sm font-display">{pkg.tag}</span>
                <h2 class="text-2xl font-display mt-2 mb-3">{pkg.name}</h2>
                <p class="text-text-secondary text-sm leading-relaxed">{pkg.desc}</p>
              </div>

              <div class="mb-6">
                <span class="text-text-muted text-xs font-display uppercase tracking-wider">Rok izrade</span>
                <p class="text-accent font-display mt-1">{pkg.timeframe}</p>
              </div>

              <div class="flex-1">
                <span class="text-text-muted text-xs font-display uppercase tracking-wider">Uključeno</span>
                <ul class="mt-3 space-y-3">
                  {pkg.includes.map(item => (
                    <li class="flex items-start gap-2 text-sm text-text-secondary">
                      <svg class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8">
                <a 
                  href="/kontakt/" 
                  class={`block text-center px-6 py-3 font-display font-medium text-sm tracking-wide rounded transition-colors ${pkg.featured ? 'bg-accent text-bg-primary hover:bg-accent-glow' : 'border border-border text-text-primary hover:border-accent/50'}`}
                >
                  {pkg.cta}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Add-ons -->
      <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12 reveal">
          <h2 class="text-3xl font-display mb-4">Dodatne usluge</h2>
          <p class="text-text-secondary">
            Moduli koje možete dodati bilo kom paketu, u zavisnosti od specifičnih potreba.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {addons.map((addon, i) => (
            <div class="p-6 rounded-xl bg-bg-elevated accent-border reveal" class:list={[`reveal-delay-${i + 1}`]}>
              <h3 class="font-display text-lg mb-2">{addon.title}</h3>
              <p class="text-text-secondary text-sm leading-relaxed">{addon.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQ for pricing -->
      <div class="max-w-3xl mx-auto mb-20">
        <h2 class="text-3xl font-display text-center mb-12 reveal">Česta pitanja o cenama</h2>
        <div class="space-y-4">
          <details class="group rounded-lg bg-bg-elevated accent-border p-6 cursor-pointer reveal">
            <summary class="font-display text-lg list-none flex justify-between items-center">
              Zašto nemate fiksne cene na sajtu?
              <span class="ml-4 text-accent group-open:rotate-180 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <p class="mt-4 text-text-secondary leading-relaxed">
              Svaka kompanija ima drugačiji digitalni otisak — broj domena, kompleksnost infrastrukture, 
              veličina organizacije. Fiksna cena bi značila da neke kompanije plaćaju previše, 
              a druge ne dobijaju dovoljnu dubinu analize. Personalizovana ponuda garantuje 
              da platite samo za ono što vam je stvarno potrebno.
            </p>
          </details>

          <details class="group rounded-lg bg-bg-elevated accent-border p-6 cursor-pointer reveal">
            <summary class="font-display text-lg list-none flex justify-between items-center">
              Šta ako nam ne treba ceo paket?
              <span class="ml-4 text-accent group-open:rotate-180 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <p class="mt-4 text-text-secondary leading-relaxed">
              Sve usluge su modularne. Ako vam je potrebna samo analiza DNS infrastrukture 
              ili samo provera curenja podataka, kontaktirajte nas i napravićemo ponudu 
              prilagođenu vašim specifičnim potrebama.
            </p>
          </details>

          <details class="group rounded-lg bg-bg-elevated accent-border p-6 cursor-pointer reveal">
            <summary class="font-display text-lg list-none flex justify-between items-center">
              Kako funkcioniše besplatni osnovni sken?
              <span class="ml-4 text-accent group-open:rotate-180 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <p class="mt-4 text-text-secondary leading-relaxed">
              Pošaljete nam domen vaše kompanije. U roku od 24 sata analiziramo osnovne 
              ranjivosti — DNS konfiguraciju, curele naloge, otkrivene poddomene — i 
              šaljemo vam mini-izveštaj. Bez obaveze. Bez kreditne kartice. Bez prodajnog 
              pritiska. Ako vam se dopadne kvalitet, diskutujemo o daljoj saradnji.
            </p>
          </details>
        </div>
      </div>

      <!-- Final CTA -->
      <div class="relative rounded-2xl bg-bg-elevated accent-border p-12 md:p-16 text-center overflow-hidden reveal">
        <div class="absolute inset-0 bg-gradient-to-r from-accent/5 to-transparent pointer-events-none"></div>
        <div class="relative z-10 max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-display mb-6">
            Ne znate koji paket vam odgovara?
          </h2>
          <p class="text-text-secondary mb-10 leading-relaxed">
            Zakažite 15-minutni razgovor. Objasnićemo šta svaki paket uključuje 
            i predložićemo najbolju opciju za vašu situaciju — bez prodajnog pritiska.
          </p>
          <a href="/kontakt/" class="inline-flex items-center px-8 py-4 bg-accent text-bg-primary font-display font-medium text-sm tracking-wide rounded hover:bg-accent-glow transition-colors">
            Zakažite besplatan razgovor
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
