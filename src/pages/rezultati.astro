---
import Layout from '../layouts/Layout.astro';

const title = 'Rezultati — Šta Inventus otkriva za klijente';
const description = 'Pregled tipičnih nalaza iz naših analiza: curenje podataka, ranjivosti domena, lažni sajtovi i digitalni rizici koje otkrivamo za kompanije.';

const findings = [
  {
    category: 'Digitalni otisak',
    icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
    items: [
      { severity: 'high', label: 'Zaboravljeni poddomeni sa testnim okruženjima' },
      { severity: 'high', label: 'Javno dostupni interni dokumenti i prezentacije' },
      { severity: 'medium', label: 'Arhivirane verzije sajtova sa zastarelim podacima' },
      { severity: 'medium', label: 'Profili bivših zaposlenih sa poverljivim informacijama' },
      { severity: 'low', label: 'Neažurirani poslovni podaci u javnim registrima' }
    ]
  },
  {
    category: 'Curenje podataka',
    icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
    items: [
      { severity: 'critical', label: 'Kompromitovani admin nalozi u javnim bazama curenja' },
      { severity: 'high', label: 'Curele lozinke povezane sa kompanijskim domenom' },
      { severity: 'high', label: 'Interni dokumenti na javnim cloud storage servisima' },
      { severity: 'medium', label: 'Email adresa zaposlenih na dark web forumima' },
      { severity: 'medium', label: 'Izvorni kod sa internim API ključevima na GitHub-u' }
    ]
  },
  {
    category: 'Zaštita brenda',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    items: [
      { severity: 'critical', label: 'Aktivne phishing stranice koje kopiraju vaš sajt' },
      { severity: 'high', label: 'Typosquat domeni registrovani u poslednjih 6 meseci' },
      { severity: 'high', label: 'Lažni profili na društvenim mrežama u vaše ime' },
      { severity: 'medium', label: 'Neovlašćena upotreba logoa na sumnjivim sajtovima' },
      { severity: 'low', label: 'Negativni sadržaj i lažne vesti povezane sa brendom' }
    ]
  },
  {
    category: 'Email / Domen sigurnost',
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    items: [
      { severity: 'critical', label: 'Nekonfigurisan DMARC — email lažno predstavljanje moguće' },
      { severity: 'high', label: 'Subdomeni bez validnih SSL sertifikata' },
      { severity: 'high', label: 'Otkriveni API ključevi i tokeni u javnim repozitorijumima' },
      { severity: 'medium', label: 'Zastareli DNS zapisi koji vode na nepoznate servere' },
      { severity: 'medium', label: 'SPF record koji dozvoljava previše izvora' }
    ]
  }
];

const severityConfig = {
  critical: { color: 'text-red-400', bg: 'bg-red-400/10', label: 'Kritično' },
  high: { color: 'text-amber-400', bg: 'bg-amber-400/10', label: 'Visok' },
  medium: { color: 'text-yellow-400', bg: 'bg-yellow-400/10', label: 'Srednji' },
  low: { color: 'text-text-muted', bg: 'bg-text-muted/10', label: 'Nizak' }
};
---

<Layout title={title} description={description}>
  <div class="section-padding pt-24">
    <div class="container-wide mx-auto">
      <!-- Hero -->
      <div class="max-w-3xl mx-auto text-center mb-16 reveal">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent/30 bg-accent/5 mb-8">
          <span class="font-display text-xs tracking-wider text-accent uppercase">Rezultati</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-display mb-6">
          Šta otkrivamo <span class="text-gradient">za klijente</span>
        </h1>
        <p class="text-text-secondary text-lg leading-relaxed">
          Svaka kompanija ima digitalne tragove koje njeni vlasnici ne vide. 
          Ovo su kategorije nalaza koje rutinski otkrivamo u našim analizama — 
          rangirane po ozbiljnosti i potencijalnom uticaju na poslovanje.
        </p>
      </div>

      <!-- Findings Grid -->
      <div class="grid lg:grid-cols-2 gap-8 mb-20">
        {findings.map((f, i) => (
          <div class="p-8 rounded-xl bg-bg-elevated accent-border reveal" class:list={[`reveal-delay-${(i % 2) + 1}`]}>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={f.icon}></path>
                </svg>
              </div>
              <h2 class="text-xl font-display">{f.category}</h2>
            </div>
            <ul class="space-y-3">
              {f.items.map(item => {
                const sev = severityConfig[item.severity];
                return (
                  <li class="flex items-start gap-3">
                    <span class={`px-2 py-0.5 rounded text-xs font-display flex-shrink-0 mt-0.5 ${sev.bg} ${sev.color}`}>
                      {sev.label}
                    </span>
                    <span class="text-text-secondary text-sm">{item.label}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>

      <!-- Why it matters -->
      <div class="max-w-3xl mx-auto mb-20 reveal">
        <h2 class="text-3xl font-display text-center mb-8">Zašto ovo nije "teorijski rizik"</h2>
        <div class="space-y-6">
          <div class="flex gap-4 p-6 rounded-xl bg-bg-elevated accent-border">
            <div class="w-10 h-10 rounded-lg bg-red-400/10 flex items-center justify-center flex-shrink-0">
              <span class="font-display text-red-400 text-sm">01</span>
            </div>
            <div>
              <h3 class="font-display mb-1">Kompromitovani admin nalog = direktan pristup</h3>
              <p class="text-text-secondary text-sm">Kada email i lozinka admin naloga procure u javnu bazu, napadač ima potencijalni pristup svim sistemima povezanim sa tim nalogom — cloud, CRM, interni alati.</p>
            </div>
          </div>
          <div class="flex gap-4 p-6 rounded-xl bg-bg-elevated accent-border">
            <div class="w-10 h-10 rounded-lg bg-amber-400/10 flex items-center justify-center flex-shrink-0">
              <span class="font-display text-amber-400 text-sm">02</span>
            </div>
            <div>
              <h3 class="font-display mb-1">Phishing sajtovi u vaše ime = direktan gubitak poverenja</h3>
              <p class="text-text-secondary text-sm">Lažni sajt koji kopira vaš brend i prikuplja podatke klijenata ne šteti samo njima — šteti vašoj reputaciji i može dovesti do regulatornih sankcija.</p>
            </div>
          </div>
          <div class="flex gap-4 p-6 rounded-xl bg-bg-elevated accent-border">
            <div class="w-10 h-10 rounded-lg bg-yellow-400/10 flex items-center justify-center flex-shrink-0">
              <span class="font-display text-yellow-400 text-sm">03</span>
            </div>
            <div>
              <h3 class="font-display mb-1">Javni dokumenti = plan napada za konkurenciju</h3>
              <p class="text-text-secondary text-sm">Interna prezentacija sa detaljima o arhitekturi sistema, imenima dobavljača ili planovima za proizvod — sve je to strategija u rukama konkurenta.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="relative rounded-2xl bg-bg-elevated accent-border p-12 md:p-16 text-center overflow-hidden reveal">
        <div class="absolute inset-0 bg-gradient-to-r from-accent/5 to-transparent pointer-events-none"></div>
        <div class="relative z-10 max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-display mb-6">
            Saznajte šta internet zna o <span class="text-gradient">vašoj</span> kompaniji
          </h2>
          <p class="text-text-secondary mb-10 leading-relaxed">
            Svaka analiza počinje besplatnim osnovnim skenom. U roku od 24 sata dobijate 
            pregled najkritičnijih nalaza — bez obaveze, bez kreditne kartice.
          </p>
          <a href="/kontakt/" class="inline-flex items-center px-8 py-4 bg-accent text-bg-primary font-display font-medium text-sm tracking-wide rounded hover:bg-accent-glow transition-colors">
            Zatražite besplatni sken
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
