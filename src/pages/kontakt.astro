---
import Layout from '../layouts/Layout.astro';

const title = 'Kontakt — Zatražite digitalnu obaveštajnu analizu';
const description = 'Kontaktirajte Inventus za besplatnu konsultaciju o digitalnoj obaveštajnoj analizi, zaštiti brenda i bezbednosnoj proceni vaše kompanije.';

const success = Astro.url.searchParams.get('success') === '1';
---

<Layout title={title} description={description}>
  <div class="section-padding pt-24">
    <div class="container-wide mx-auto">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-display mb-6">Kontakt</h1>
        <p class="text-text-secondary text-lg leading-relaxed">
          Zainteresovani ste za digitalnu obaveštajnu analizu? <br/>
          Pošaljite nam upit i odgovorićemo u najkraćem roku.
        </p>
      </div>
      
      {success && (
        <div class="max-w-2xl mx-auto mb-12 p-6 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-center">
          <div class="w-12 h-12 rounded-full bg-emerald-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="font-display text-lg text-emerald-400 mb-2">Poruka uspešno poslata</h3>
          <p class="text-text-secondary text-sm">Hvala na interesovanju. Odgovorićemo vam u roku od 24 sata.</p>
        </div>
      )}
      
      <div class="grid lg:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <div class="space-y-8">
          <div class="p-8 rounded-xl bg-bg-elevated accent-border">
            <h2 class="text-xl font-display mb-6">Načini kontakta</h2>
            
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-display text-sm text-text-muted mb-1">Email</h3>
                  <a href="mailto:hello@inventus.agency" class="text-text-primary hover:text-accent transition-colors">hello@inventus.agency</a>
                </div>
              </div>
              
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-display text-sm text-text-muted mb-1">Vreme odgovora</h3>
                  <p class="text-text-primary">Obično u roku od 24 sata</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-display text-sm text-text-muted mb-1">Diskrecija</h3>
                  <p class="text-text-primary">Sve komunikacije su poverljive</p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="p-8 rounded-xl bg-bg-elevated accent-border">
            <h2 class="text-xl font-display mb-4">Šta nam poslati?</h2>
            <p class="text-text-secondary text-sm leading-relaxed mb-4">
              Da bismo vam dali što precizniju ponudu, poželjno je da u prvom kontaktu navedete:
            </p>
            <ul class="space-y-2 text-text-secondary text-sm">
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                <span>Naziv kompanije i domen koji želite da analiziramo</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                <span>Koju uslugu vas zanima (ili opis problema koji rešavate)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                <span>Rok u kojem vam je potreban izveštaj</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                <span>Da li želite jednokratnu analizu ili redovan monitoring</span>
              </li>
            </ul>
          </div>
        </div>
        
        <div class="p-8 rounded-xl bg-bg-elevated accent-border">
          <h2 class="text-xl font-display mb-6">Pošaljite upit</h2>
          <form 
            class="space-y-6" 
            action="https://api.web3forms.com/submit" 
            method="POST"
          >
            <input type="hidden" name="access_key" value="4e38a0fe-0016-42c9-a408-7d25d366f913">
            <input type="hidden" name="redirect" value="https://inventus.agency/kontakt/?success=1">
            <input type="hidden" name="from_name" value="Inventus Kontakt Forma">
            <input type="hidden" name="subject" value="Novi upit sa inventus.agency">
            
            <div>
              <label for="name" class="block font-display text-sm text-text-muted mb-2">Ime i prezime / Kompanija *</label>
              <input 
                type="text" 
                id="name" 
                name="name"
                required
                class="w-full px-4 py-3 rounded-lg bg-bg-primary border border-border text-text-primary placeholder-text-muted focus:border-accent focus:outline-none transition-colors"
                placeholder="npr. Petar Petrović, ACME d.o.o."
              />
            </div>
            
            <div>
              <label for="email" class="block font-display text-sm text-text-muted mb-2">Email adresa *</label>
              <input 
                type="email" 
                id="email" 
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg bg-bg-primary border border-border text-text-primary placeholder-text-muted focus:border-accent focus:outline-none transition-colors"
                placeholder="vas@email.com"
              />
            </div>
            
            <div>
              <label for="service" class="block font-display text-sm text-text-muted mb-2">Usluga koja vas zanima</label>
              <select 
                id="service" 
                name="service"
                class="w-full px-4 py-3 rounded-lg bg-bg-primary border border-border text-text-primary focus:border-accent focus:outline-none transition-colors"
              >
                <option value="">Izaberite uslugu...</option>
                <option value="digitalni-otisak">Digitalni otisak kompanije</option>
                <option value="monitoring-curenja">Monitoring curenja podataka</option>
                <option value="zastita-brenda">Zaštita brenda</option>
                <option value="obavestajna-analiza">Obaveštajna analiza konkurencije</option>
                <option value="email-domen">Email i domen sigurnost</option>
                <option value="website-inteligencija">Website inteligencija</option>
                <option value="drugo">Drugo / Više usluga</option>
              </select>
            </div>
            
            <div>
              <label for="message" class="block font-display text-sm text-text-muted mb-2">Poruka *</label>
              <textarea 
                id="message" 
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 rounded-lg bg-bg-primary border border-border text-text-primary placeholder-text-muted focus:border-accent focus:outline-none transition-colors resize-none"
                placeholder="Opišite šta vam je potrebno..."
              ></textarea>
            </div>
            
            <button 
              type="submit"
              class="w-full px-6 py-4 bg-accent text-bg-primary font-display font-medium text-sm tracking-wide rounded hover:bg-accent-glow transition-colors"
            >
              Pošaljite upit
            </button>
            
            <p class="text-text-muted text-xs text-center">
              Podaci se šalju putem šifrovane veze. Pogledajte našu 
              <a href="/politika-privatnosti/" class="text-accent hover:underline">politiku privatnosti</a>.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</Layout>
