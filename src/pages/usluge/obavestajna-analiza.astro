---
import Layout from '../../layouts/Layout.astro';

const title = 'Obaveštajna analiza konkurencije — Digitalna strategija i slabosti';
const description = 'Dubinska analiza digitalnog prisustva konkurenata. Tehnologije, izvori saobraćaja, online strategije i slabosti u digitalnom okruženju.';

const faqs = [
  {
    q: 'Koje informacije o konkurentima možete da prikupite?',
    a: 'Koristeći isključivo javno dostupne izvore, možemo da identifikujemo tehnologije koje konkurent koristi na svom sajtu, procenimo izvore njihovog online saobraćaja, analiziramo njihovu SEO strategiju i ključne reči, pregledamo njihove digitalne kanale i prisustvo na društvenim mrežama, identifikujemo zaposlene i njihove uloge, kao i pronađemo tehničke slabosti u njihovoj javnoj infrastrukturi. Sve ovo je javno dostupno svakome — mi samo sistematizujemo i analiziramo podatke.'
  },
  {
    q: 'Da li je analiza konkurencije legalna?',
    a: 'Potpuno. Sve informacije koje prikupljamo su javno dostupne na internetu. Ne pristupamo zaštićenim sistemima, ne hakujemo niti koristimo bilo kakve ilegalne metode. Svaka informacija koju pronađemo je dostupna bilo kom ko zna gde da traži — mi samo radimo to efikasnije i sistematičnije.'
  }
];
---

<Layout title={title} description={description}>
  <article class="section-padding pt-24">
    <div class="container-wide mx-auto">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <a href="/usluge/" class="text-text-muted hover:text-accent transition-colors text-sm font-display">Usluge</a>
          <span class="text-border">/</span>
          <span class="text-accent text-sm font-display">Obaveštajna analiza</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-display mb-6">Obaveštajna analiza konkurencije</h1>
        <p class="text-xl text-text-secondary leading-relaxed mb-12">
          Razumevanje digitalne strategije vaših konkurenata nije špijunaža — 
          to je pametno poslovanje. Pružamo uvid u njihove tehnologije, 
          izvore saobraćaja i online slabosti koristeći isključivo javno dostupne podatke.
        </p>
      </div>
      
      <div class="grid lg:grid-cols-3 gap-8 mb-16">
        <div class="lg:col-span-2 space-y-8">
          <section>
            <h2 class="text-2xl font-display mb-4">Šta uključuje analiza?</h2>
            <div class="grid md:grid-cols-2 gap-4">
              {[
                'Tehnološki stek sajta i aplikacija',
                'Izvori online saobraćaja i kanali',
                'SEO strategija i ciljane ključne reči',
                'Prisustvo na društvenim mrežama',
                'Struktura i sadržaj sajta',
                'Tehničke slabosti u javnoj infrastrukturi',
                'Digitalni kanali i komunikacija',
                'Poređenje sa vašom kompanijom'
              ].map(item => (
                <div class="flex items-start gap-3 p-4 rounded-lg bg-bg-elevated accent-border">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path>
                  </svg>
                  <span class="text-text-secondary text-sm">{item}</span>
                </div>
              ))}
            </div>
          </section>
        </div>
        
        <aside class="space-y-6">
          <div class="p-6 rounded-xl bg-bg-elevated accent-border sticky top-24">
            <h3 class="font-display text-lg mb-4">Brzi kontakt</h3>
            <p class="text-text-secondary text-sm mb-6">Zatražite besplatnu početnu konsultaciju.</p>
            <a href="/kontakt/" class="block w-full text-center px-6 py-3 bg-accent text-bg-primary font-display font-medium text-sm rounded hover:bg-accent-glow transition-colors mb-3">
              Besplatna bezbednosna procena
            </a>
            <a href="mailto:hello@inventus.agency" class="block w-full text-center px-6 py-3 border border-border text-text-primary font-display text-sm rounded hover:border-accent/50 transition-colors">
              hello@inventus.agency
            </a>
          </div>
        </aside>
      </div>
      
      <section class="max-w-3xl">
        <h2 class="text-2xl font-display mb-8">Često postavljana pitanja</h2>
        <div class="space-y-4">
          {faqs.map(faq => (
            <details class="group rounded-lg bg-bg-elevated accent-border p-6 cursor-pointer">
              <summary class="font-display list-none flex justify-between items-center">{faq.q}
                <span class="ml-4 text-accent group-open:rotate-180 transition-transform">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </span>
              </summary>
              <p class="mt-4 text-text-secondary leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </article>
</Layout>
